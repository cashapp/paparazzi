"""
Verifies Paparazzi against a layoutlib version and records it in gradle/layoutlib-compat.properties.

    scripts/verify-layoutlib-version <version> [--write] [--skip-render]

Checks, in order (any failure exits non-zero):
  1. artifacts   layoutlib, layoutlib-resources and layoutlib-runtime (every OS classifier) exist
  2. icu         the ICU data file in layoutlib-runtime/data/icu, identical across classifiers
  3. api         minimum layoutlib-api satisfying every API reference in the layoutlib jar
  4. linkage     every layoutlib class/method/field Paparazzi references directly still exists
                 (reflective access through LayoutlibCompat is intentionally not covered)
  5. resources   res/ layout, resource types, qualifiers and value tags vs the default version
  6. render      LayoutlibCompatibilityTest against the version (static, SHRINK and gif snapshots)

Static checks can't see behavioral changes (e.g. 17.0.3 dropping BridgeRenderSession.getImage()
while the API default still exists), which is why the render step is required before --write
is meaningful. --write updates the properties file after steps 1-5 so the render step picks it up.

Requires python3 (stdlib only), network access to dl.google.com and a JDK for Gradle.
"""
import argparse
import collections
import os
import re
import struct
import subprocess
import sys
import tempfile
import urllib.request
import zipfile

ROOT = os.path.dirname(os.path.dirname(os.path.abspath(__file__)))
COMPAT_FILE = os.path.join(ROOT, "gradle", "layoutlib-compat.properties")
TOML = os.path.join(ROOT, "gradle", "libs.versions.toml")
MAVEN = "https://dl.google.com/android/maven2/com/android/tools/layoutlib"
CLASSIFIERS = ["linux", "win", "mac", "mac-arm"]
API_PKGS = ("com/android/ide/common/rendering/api/", "com/android/resources/")
JDK_PKGS = ("java/", "javax/", "jdk/", "sun/")
# Members a class can inherit from JDK supertypes (Object, Enum, AutoCloseable, Iterable, ...).
JDK_INHERITED = {
  "<init>", "equals", "hashCode", "toString", "getClass", "clone", "finalize", "notify", "notifyAll", "wait",
  "name", "ordinal", "compareTo", "getDeclaringClass", "valueOf", "describeConstable",
  "close", "iterator", "forEach", "spliterator",
}
# Oldest layoutlib-api considered when searching for the minimum.
API_FLOOR = (31, 0, 0)
CACHE = os.path.join(tempfile.gettempdir(), "paparazzi-layoutlib-verify")


class Failure(Exception):
  pass


def log(step, msg):
  print(f"[{step}] {msg}", flush=True)


def vkey(v):
  return tuple(int(x) for x in re.split(r"[.-]", v) if x.isdigit())


def fetch(url, dest=None, tail=None):
  os.makedirs(CACHE, exist_ok=True)
  dest = dest or os.path.join(CACHE, re.sub(r"[^\w.-]", "_", url.split("/layoutlib/")[-1]) + (f".tail{tail}" if tail else ""))
  if os.path.exists(dest):
    return dest
  req = urllib.request.Request(url, headers={"Range": f"bytes=-{tail}"} if tail else {})
  try:
    with urllib.request.urlopen(req, timeout=300) as r, open(dest + ".part", "wb") as f:
      while chunk := r.read(1 << 20):
        f.write(chunk)
  except Exception as e:
    raise Failure(f"download failed: {url}: {e}")
  os.replace(dest + ".part", dest)
  return dest


def artifact(name, version, classifier=None):
  suffix = f"-{classifier}" if classifier else ""
  return f"{MAVEN}/{name}/{version}/{name}-{version}{suffix}.jar"


# ---------------------------------------------------------------- class file parsing

def constant_pool(data):
  n = struct.unpack(">H", data[8:10])[0]
  i, k, pool = 10, 1, [None] * n
  while k < n:
    t = data[i]
    if t == 1:
      ln = struct.unpack(">H", data[i + 1:i + 3])[0]
      pool[k] = (1, data[i + 3:i + 3 + ln].decode("utf8", "replace"))
      i += 3 + ln
    elif t in (3, 4):
      i += 5
    elif t in (5, 6):
      i += 9
      k += 1
    elif t in (7, 8, 16, 19, 20):
      pool[k] = (t, struct.unpack(">H", data[i + 1:i + 3])[0])
      i += 3
    elif t in (9, 10, 11, 12, 17, 18):
      pool[k] = (t,) + struct.unpack(">HH", data[i + 1:i + 5])
      i += 5
    elif t == 15:
      i += 4
    else:
      raise ValueError(f"bad constant tag {t}")
    k += 1
  return pool, i


def references(jar, owner_filter, skip_own=()):
  """Class ('C', cls) and member ('M'/'F', cls, name, desc) references whose owner matches."""
  out = set()
  with zipfile.ZipFile(jar) as z:
    for n in z.namelist():
      if not n.endswith(".class") or n.startswith(skip_own):
        continue
      pool, _ = constant_pool(z.read(n))
      utf = lambda x: pool[x][1]
      for e in pool:
        if not e:
          continue
        if e[0] == 7:
          c = utf(e[1]).lstrip("[")
          if c.startswith("L"):
            c = c[1:-1]
          if owner_filter(c):
            out.add(("C", c))
        elif e[0] in (9, 10, 11):
          c = utf(pool[e[1]][1])
          if owner_filter(c):
            nt = pool[e[2]]
            out.add(("F" if e[0] == 9 else "M", c, utf(nt[1]), utf(nt[2])))
  return out


def declarations(jar, only=None):
  """class -> (super, interfaces, {(kind, name, desc)})"""
  classes = {}
  with zipfile.ZipFile(jar) as z:
    for n in z.namelist():
      if not n.endswith(".class") or (only and not n.startswith(only)):
        continue
      d = z.read(n)
      pool, i = constant_pool(d)
      utf = lambda x: pool[x][1]
      _, this, sup, ic = struct.unpack(">HHHH", d[i:i + 8])
      i += 8
      ifs = [utf(pool[struct.unpack(">H", d[i + 2 * j:i + 2 * j + 2])[0]][1]) for j in range(ic)]
      i += 2 * ic
      members = set()
      for kind in "FM":
        count = struct.unpack(">H", d[i:i + 2])[0]
        i += 2
        for _ in range(count):
          _, nm, ds, ac = struct.unpack(">HHHH", d[i:i + 8])
          i += 8
          for _ in range(ac):
            i += 6 + struct.unpack(">I", d[i + 2:i + 6])[0]
          members.add((kind, utf(nm), utf(ds)))
      classes[utf(pool[this][1])] = (utf(pool[sup][1]) if sup else None, ifs, members)
  return classes


def resolves(classes, cls, kind, name, desc):
  if cls not in classes:
    return False
  sup, ifs, members = classes[cls]
  if (kind, name, desc) in members:
    return True
  for parent in ([sup] if sup else []) + ifs:
    if parent not in classes:
      if parent.startswith(JDK_PKGS) and name in JDK_INHERITED:
        return True  # inherited from the JDK (e.g. Enum.ordinal, Object.hashCode)
      continue
    if resolves(classes, parent, kind, name, desc):
      return True
  return False


def missing(refs, classes):
  out = set()
  for r in refs:
    if r[1] not in classes:
      out.add(("C", r[1]))
    elif r[0] != "C" and not resolves(classes, r[1], r[0], r[2], r[3]):
      out.add(r)
  return sorted(out)


def fmt(ref):
  return ref[1].replace("/", ".") if ref[0] == "C" else f"{ref[1].replace('/', '.')}#{ref[2]}{ref[3]}"


# ---------------------------------------------------------------- steps

def check_artifacts(version):
  urls = [artifact("layoutlib", version), artifact("layoutlib-resources", version)] + [
    artifact("layoutlib-runtime", version, c) for c in CLASSIFIERS
  ]
  for url in urls:
    req = urllib.request.Request(url, method="HEAD")
    try:
      urllib.request.urlopen(req, timeout=60)
    except Exception as e:
      raise Failure(f"missing artifact {url}: {e}")
  log("artifacts", f"layoutlib, layoutlib-resources, layoutlib-runtime [{', '.join(CLASSIFIERS)}] present")


def check_icu(version):
  names = {}
  for c in CLASSIFIERS:
    # The zip central directory lives at the end of the archive; no need to fetch ~80MB.
    tail = fetch(artifact("layoutlib-runtime", version, c), tail=1_000_000)
    found = sorted(set(re.findall(rb"data/icu/(icudt\d+l\.dat)", open(tail, "rb").read())))
    if len(found) != 1:
      raise Failure(f"expected exactly one ICU data file in layoutlib-runtime {c}, found {found}")
    names[c] = found[0].decode()
  if len(set(names.values())) != 1:
    raise Failure(f"ICU data file differs across classifiers: {names}")
  icu = next(iter(names.values()))
  log("icu", f"{icu} (all classifiers)")
  return icu


def stable_api_versions():
  meta = urllib.request.urlopen(f"{MAVEN}/layoutlib-api/maven-metadata.xml", timeout=60).read().decode()
  versions = re.findall(r"<version>([\d.]+)</version>", meta)
  return sorted((v for v in versions if vkey(v) >= API_FLOOR), key=vkey)


def pinned_api_version():
  m = re.search(r'tools-layoutlib-api\s*=\s*\{[^}]*version\s*=\s*"([^"]+)"', open(TOML).read())
  if not m:
    raise Failure("could not find tools-layoutlib-api version in libs.versions.toml")
  return m.group(1)


def check_api(version, layoutlib_jar):
  refs = references(layoutlib_jar, lambda c: c.startswith(API_PKGS), skip_own=API_PKGS)
  pinned = pinned_api_version()
  candidates = [v for v in stable_api_versions() if vkey(v) >= vkey(pinned)]
  last_gaps = []
  for api in candidates:
    gaps = missing(refs, declarations(fetch(artifact("layoutlib-api", api))))
    if not gaps:
      if api == pinned:
        log("api", f"pinned layoutlib-api {pinned} satisfies all {len(refs)} references")
        return None
      log("api", f"requires layoutlib-api >= {api} (pinned {pinned} lacks: {', '.join(fmt(g) for g in last_gaps[:5])})")
      return api
    last_gaps = gaps
  raise Failure(f"no layoutlib-api release satisfies layoutlib {version}; newest still lacks: "
                f"{', '.join(fmt(g) for g in gaps[:10])}")


def paparazzi_jar():
  log("linkage", "building :paparazzi:jar")
  subprocess.run([os.path.join(ROOT, "gradlew"), "-q", ":paparazzi:jar"], cwd=ROOT, check=True)
  libs = os.path.join(ROOT, "paparazzi", "build", "libs")
  jars = [j for j in os.listdir(libs) if j.endswith(".jar") and not re.search(r"sources|javadoc", j)]
  if not jars:
    raise Failure("paparazzi jar not found")
  return os.path.join(libs, max(jars, key=lambda j: os.path.getmtime(os.path.join(libs, j))))


def check_linkage(version, layoutlib_jar, default_jar, api):
  api_jar = fetch(artifact("layoutlib-api", api or pinned_api_version()))
  api_classes = declarations(api_jar)
  # layoutlib classes extend layoutlib-api ones (e.g. layoutlib Bridge -> api Bridge).
  target = {**api_classes, **declarations(layoutlib_jar)}
  baseline = declarations(default_jar)
  pz = paparazzi_jar()
  # Only references resolvable against the default layoutlib: that's what Paparazzi links against.
  refs = references(pz, lambda c: c in baseline and not c.startswith(API_PKGS))
  gaps = missing(refs, target)
  if gaps:
    raise Failure("Paparazzi links against layoutlib members missing in "
                  f"{version} (route through LayoutlibCompat):\n    " + "\n    ".join(fmt(g) for g in gaps))
  api_gaps = missing(references(pz, lambda c: c.startswith(API_PKGS)), api_classes)
  if api_gaps:
    raise Failure(f"Paparazzi references missing from layoutlib-api {api}: {', '.join(fmt(g) for g in api_gaps)}")
  log("linkage", f"{len(refs)} direct layoutlib references and layoutlib-api {api or pinned_api_version()} resolve")


def resource_shape(jar):
  shape = collections.defaultdict(set)
  with zipfile.ZipFile(jar) as z:
    names = [n for n in z.namelist() if n.startswith("res/") and not n.endswith("/")]
    for n in names:
      folder = n.split("/")[1]
      parts = folder.split("-")
      shape["types"].add(parts[0])
      shape["qualifiers"].update(parts[1:])
      if parts[0] == "values":
        text = re.sub(rb"<!--.*?-->", b"", z.read(n), flags=re.S)
        shape["tags"].update(t.decode() for t in re.findall(rb"<([A-Za-z][\w-]*)[\s>/]", text))
    shape["attrs.xml"] = {"present"} if "res/values/attrs.xml" in names else set()
  return shape


def check_resources(version, default):
  new = resource_shape(fetch(artifact("layoutlib-resources", version)))
  base = resource_shape(fetch(artifact("layoutlib-resources", default)))
  if not new["attrs.xml"]:
    raise Failure("layoutlib-resources has no res/values/attrs.xml (required by Bridge.init)")
  added = {k: sorted(new[k] - base[k]) for k in ("types", "qualifiers", "tags")}
  removed = {k: sorted(base[k] - new[k]) for k in ("types", "qualifiers", "tags")}
  if added["types"] or added["tags"]:
    raise Failure(
      f"layoutlib-resources {version} adds resource types {added['types']} / value tags {added['tags']} "
      f"vs {default}; verify FrameworkResourceRepository handles them before adding a resource hook")
  notes = [f"+{k} {v}" for k, v in added.items() if v] + [f"-{k} {v}" for k, v in removed.items() if v]
  log("resources", "same shape as default " + default + (f" ({'; '.join(notes)})" if notes else ""))


def default_version():
  m = re.search(r'^layoutlib\s*=\s*"([^"]+)"', open(TOML).read(), re.M)
  if not m:
    raise Failure("could not find layoutlib version in libs.versions.toml")
  return m.group(1)


def write_entry(version, icu, api):
  lines = open(COMPAT_FILE).read().splitlines()
  header = [l for l in lines if not re.match(r"^[\w.-]+\.(icu|minLayoutlibApi)=", l)]
  entries = {}
  for l in lines:
    m = re.match(r"^([\w.-]+?)\.(icu|minLayoutlibApi)=(.*)$", l)
    if m:
      entries.setdefault(m.group(1), {})[m.group(2)] = m.group(3)
  entries[version] = {"icu": icu, **({"minLayoutlibApi": api} if api else {})}
  body = []
  for v in sorted(entries, key=lambda v: (vkey(v), v)):
    for key in ("icu", "minLayoutlibApi"):
      if key in entries[v]:
        body.append(f"{v}.{key}={entries[v][key]}")
  while header and header[-1] == "":
    header.pop()
  open(COMPAT_FILE, "w").write("\n".join(header + [""] + body) + "\n")
  log("write", f"recorded {version} in {os.path.relpath(COMPAT_FILE, ROOT)}")


def render(version):
  log("render", f"running LayoutlibCompatibilityTest for {version}")
  subprocess.run([
    os.path.join(ROOT, "gradlew"), ":paparazzi-gradle-plugin:test",
    "--tests", "app.cash.paparazzi.gradle.LayoutlibCompatibilityTest", "--rerun",
    f"-Ppaparazzi.layoutlib.versionsUnderTest={version}",
  ], cwd=ROOT, check=True)
  log("render", "ok")


def main():
  parser = argparse.ArgumentParser(description=__doc__, formatter_class=argparse.RawDescriptionHelpFormatter)
  parser.add_argument("version")
  parser.add_argument("--write", action="store_true", help="record the result in layoutlib-compat.properties")
  parser.add_argument("--skip-render", action="store_true", help="static checks only")
  args = parser.parse_args()

  default = default_version()
  try:
    check_artifacts(args.version)
    icu = check_icu(args.version)
    layoutlib_jar = fetch(artifact("layoutlib", args.version))
    api = check_api(args.version, layoutlib_jar)
    check_linkage(args.version, layoutlib_jar, fetch(artifact("layoutlib", default)), api)
    check_resources(args.version, default)
    if args.write:
      write_entry(args.version, icu, api)
    if not args.skip_render:
      if not args.write and args.version not in open(COMPAT_FILE).read():
        log("render", "note: version not in layoutlib-compat.properties; layoutlib-api alignment "
                      "falls back to the closest known version (use --write to record it first)")
      render(args.version)
  except subprocess.CalledProcessError as e:
    print(f"\nFAILED: {' '.join(e.cmd[:2])} exited {e.returncode}", file=sys.stderr)
    return 1
  except Failure as e:
    print(f"\nFAILED: {e}", file=sys.stderr)
    return 1

  entry = f"{args.version}.icu={icu}" + (f"\n{args.version}.minLayoutlibApi={api}" if api else "")
  print(f"\nlayoutlib {args.version} verified.\n{entry}")
  return 0


if __name__ == "__main__":
  sys.exit(main())
